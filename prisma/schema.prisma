generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Quote {
  id                 String   @id @default(cuid())
  numeroCotizacion   String   @unique
  nombre             String
  empresa            String?
  email              String?
  telefono           String
  tipoServicio       String
  tipoEquipo         String?
  cantidadEquipos    Int?
  descripcion        String?
  estado             String   @default("recibida")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("quotes")
}
